PORT=5000
NODE_ENV=development
# Use a dedicated DB user, TLS, and a network allowlist for production.
MONGODB_URI=your_mongodb_connection_string

# Frontend ka domain (CORS + reset-password link). Same server se serve ho to wahi domain.
# Ek se zyada ho to comma se alag karein.
CLIENT_URL=http://localhost:5000

# true = backend hi frontend folder serve karega (sabse aasan live setup)
SERVE_FRONTEND=true
# Sirf tab true karein jab frontend aur backend bilkul alag domains hon
COOKIE_CROSS_SITE=false

JWT_SECRET=replace_with_at_least_32_random_characters
# Email OTPs are HMAC-hashed with this secret and expire after 10 minutes.
SESSION_SECRET=replace_with_a_different_random_secret
# Optional locally; configure a Redis URL in production to share rate limits across instances.
# REDIS_URL=redis://localhost:6379

# EmailJS template: To Email = {{to_email}}, Subject = {{subject}},
# and HTML content = {{{message_html}}}. Enable a private key in EmailJS account security.
EMAILJS_SERVICE_ID=service_ux01snf
EMAILJS_TEMPLATE_ID=template_c42mhaf
EMAILJS_PUBLIC_KEY=ve7cnNEk8Ofhr655J
EMAILJS_PRIVATE_KEY=eJGjr1Kakf5_iwn03CDwM

CLOUDINARY_CLOUD_NAME=wp1ojefq
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

