PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_connection_string

# Frontend ka domain (CORS + reset-password link). Same server se serve ho to wahi domain.
# Ek se zyada ho to comma se alag karein.
CLIENT_URL=http://localhost:5000

# true = backend hi frontend folder serve karega (sabse aasan live setup)
SERVE_FRONTEND=true
# Sirf tab true karein jab frontend aur backend bilkul alag domains par hon
COOKIE_CROSS_SITE=false

JWT_SECRET=replace_with_at_least_32_random_characters
SESSION_SECRET=replace_with_a_different_random_secret

MAIL_USER=your_gmail_address
MAIL_APP_PASSWORD=your_gmail_app_password
MAIL_FROM=Khushi Online Centre

CLOUDINARY_CLOUD_NAME=wp1ojefq
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Sirf seed script ke liye (npm run seed:admin) - kabhi commit na karein
ADMIN_NAME=Kop Singh Malviya
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE=7470630571
ADMIN_PASSWORD=choose_a_strong_password
