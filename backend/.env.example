PORT=5000
NODE_ENV=development
# Use a dedicated DB user, TLS, and a network allowlist for production.
MONGODB_URI=your_mongodb_connection_string

# Frontend ka domain (CORS + reset-password link). Same server se serve ho to wahi domain.
# Vercel frontend + Render API ho to Render par ise https://www.khushionlinecentre.com set karein.
# Alag frontend/backend domains ke liye Render par COOKIE_CROSS_SITE=true bhi set karein.
# Ek se zyada ho to comma se alag karein.
CLIENT_URL=http://localhost:5000

# true = backend hi frontend folder serve karega (sabse aasan live setup)
SERVE_FRONTEND=true
# Sirf tab true karein jab frontend aur backend bilkul alag domains hon
COOKIE_CROSS_SITE=false

JWT_SECRET=replace_with_at_least_32_random_characters
# Email OTPs are HMAC-hashed with this secret and expire after 10 minutes.
SESSION_SECRET=replace_with_a_different_random_secret
# Optional locally; configure a Redis URL in production to share rate limits across instances.
# REDIS_URL=redis://localhost:6379

# EmailJS template: To Email = {{to_email}}, Subject = {{subject}},
# and HTML content = {{{message_html}}}.
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Razorpay Dashboard > Account & Settings > API Keys / Webhooks.
# Webhook URL: https://khushi-csc.onrender.com/api/webhooks/razorpay
# Subscribe to payment.captured and payment.failed.
# Never use the API secret as the webhook secret.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_api_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

CLOUDINARY_CLOUD_NAME=wp1ojefq
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Sirf seed script ke liye - kabhi commit na karein
ADMIN_NAME=Kop Singh Malviya
ADMIN_EMAIL=khushionlinecentre11@gmail.com
ADMIN_MOBILE=7470630571
ADMIN_PASSWORD=choose_a_strong_password
